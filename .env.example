# Copy this file to ".env" (same folder) and fill in your real values.
# The .env file is gitignored and never committed.

# Steadfast Courier API credentials (from your Steadfast merchant panel)
STEADFAST_API_KEY=your-api-key-here
STEADFAST_SECRET_KEY=your-secret-key-here
# Override only if your merchant panel uses a different host:
# STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
